# Copia este archivo como backend/.env. Spring carga ese archivo al iniciar.
SUPABASE_DB_URL=jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
