# Local secrets and machine-specific environment files.
# Keep the example templates tracked.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
!**/.env.example.*

# Java / Maven / Spring Boot output
**/target/
**/build/
**/*.class
hs_err_pid*.log
replay_pid*.log

# Node / Vite / frontend output
**/node_modules/
**/dist/
**/coverage/
**/.vite/
**/.vitest/
**/.next/
**/.cache/
**/.eslintcache
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases and database exports; keep SQL schemas, migrations and seeds.
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump
*.backup

# IDE, OS and temporary files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.iml
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.temp

# Local Supabase CLI state; SQL assets under supabase-import remain trackable.
supabase/.temp/
supabase/.branches/
